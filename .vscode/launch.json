{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Animación (ventana)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Animación CLI (foto de ejemplo)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/animacion.py",
      "args": ["${input:imagen}", "--modo", "ambos"],
      "console": "integratedTerminal"
    },
    {
      "name": "Pruebas automáticas",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "tests", "-v"],
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    { "id": "imagen", "type": "promptString", "description": "Ruta de la imagen", "default": "foto.jpg" }
  ]
}
